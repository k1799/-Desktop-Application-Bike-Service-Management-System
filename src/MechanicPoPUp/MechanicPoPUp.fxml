<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="popupRoot" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: rgba(0,0,0,0.5);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MechanicPoPUp.MechanicPoPUpController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="656.0" prefWidth="727.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-padding: 25px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 5);">
         <children>
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 5 0;">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="🛠️  Add New Mechanic" />
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0056FF;" text="Personal Details" />
            <HBox spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox spacing="2.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Mechanic Id" />
                           </children>
                        </HBox>
                        <TextField fx:id="mid" editable="false" promptText="Mechanic Id" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10; -fx-text-fill: #64748B; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Mechanic Name" />
                        <TextField fx:id="mname" promptText="Enter full name" style="-fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10;" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox spacing="2.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Phone Number" />
                           </children>
                        </HBox>
                        <TextField fx:id="mphone" promptText="Enter phone number" style="-fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Email Address" />
                        <TextField fx:id="memail" promptText="Enter email (optional)" style="-fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10;" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox spacing="5.0">
               <children>
                  <HBox spacing="2.0">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="ID Proof" />
                     </children>
                  </HBox>
                  <TextField fx:id="midproof" promptText="Enter Addhar or Driving Licenece number" style="-fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10;" />
               </children>
            </VBox>
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0056FF; -fx-padding: 5 0 0 0;" text="Professional Experience &amp; Skills" />
            <HBox spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox spacing="2.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Specialization" />
                           </children>
                        </HBox>
                        <ComboBox fx:id="mspecification" maxWidth="1.7976931348623157E308" promptText="Select Specification" style="-fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-background-color: #FFFFFF; -fx-padding: 4 5;" />
                        <VBox spacing="5.0">
                           <children>
                              <HBox spacing="2.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Status" />
                                 </children>
                              </HBox>
                              <ComboBox fx:id="mstatus" maxWidth="1.7976931348623157E308" promptText="Select Status" style="-fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-background-color: #FFFFFF; -fx-padding: 4 5;" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Experience (in Years)" />
                        <TextField fx:id="mexp" promptText="e.g., 3" style="-fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10;" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox spacing="5.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Home Address" />
                  <TextArea fx:id="maddress" prefHeight="60.0" promptText="Enter current address..." style="-fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px;" wrapText="true" />
               </children>
            </VBox>
            <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 5 0;">
               <children>
                  <Button onAction="#cansel" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #0056FF; -fx-border-radius: 6px; -fx-text-fill: #0056FF; -fx-font-weight: bold; -fx-cursor: hand;" text="✕  Cancel" />
                  <Button fx:id="btnSave" onAction="#save" prefHeight="35.0" prefWidth="170.0" style="-fx-background-color: #0056FF; -fx-background-radius: 6px; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-cursor: hand;" text="💾  Save Mechanic" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
