<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="popupRoot" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: rgba(0, 0, 0, 0.5);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="BillingPoPUp.BillingPoPUpController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="817.0" prefWidth="808.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-padding: 25px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 5);">
         <children>
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 5 0;">
               <children>
                  <Label text="Billing &amp; Invoice" textFill="#1e293b">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0056FF;" text="Invoice &amp; Vehicle Summary" />
            <HBox spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Invoice / Bill No" />
                        <TextField fx:id="billno" editable="false" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10; -fx-text-fill: #1E293B; -fx-font-weight: bold;" text="INV-2026-0089" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Bill Date" />
                        <TextField fx:id="billdate" editable="false" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10; -fx-text-fill: #64748B;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Job Card Ref" />
                        <TextField fx:id="jobcardref" editable="false" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10; -fx-text-fill: #64748B;" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Customer Name" />
                        <TextField fx:id="cusname" editable="false" style="-fx-background-color: #F8FAFC; -fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10; -fx-text-fill: #475569;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Bike Number" />
                        <TextField fx:id="bknum" editable="false" style="-fx-background-color: #F8FAFC; -fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 7 10; -fx-text-fill: #475569;" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Separator style="-fx-padding: 5 0;" />
            <VBox prefHeight="207.0" prefWidth="758.0" spacing="5.0">
               <children>
                  <Label text="Used Spare Parts" textFill="#1e293b">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TableView fx:id="tblSpareParts" prefHeight="177.0" prefWidth="758.0">
                     <columns>
                        <TableColumn fx:id="colPartName" prefWidth="280.0" text="Spare Part Name" />
                        <TableColumn fx:id="colUnitPrice" prefWidth="120.0" text="Unit Price" />
                        <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Quantity" />
                        <TableColumn fx:id="colTotal" prefWidth="130.0" text="Total Amount" />
                        <TableColumn fx:id="colAction" prefWidth="110.0" text="Action" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
            <HBox spacing="15.0" />
            <HBox spacing="20.0">
               <children>
                  <VBox prefWidth="350.0" spacing="12.0" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Payment Info" textFill="#1e293b">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Payment Mode" textFill="#475569">
                                       <font>
                                          <Font name="System Bold" size="11.0" />
                                       </font>
                                    </Label>
                                    <ComboBox fx:id="cmbPaymentMode" prefWidth="150.0" promptText="Select Mode" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <ImageView fx:id="imgQR" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" visible="false" />
                     </children>
                  </VBox>
                  <VBox prefWidth="380.0" spacing="8.0">
                     <children>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Label text="Total Spare Parts Amount:" textFill="#475569" />
                              <TextField fx:id="txtTotalSpareParts" editable="false" prefWidth="110.0" promptText="0.00" style="-fx-alignment: center-right;" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Label text="Labour Charge:" textFill="#475569" />
                              <TextField fx:id="txtLabourCharge" prefWidth="110.0" promptText="0.00" style="-fx-alignment: center-right;" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 5 0 0 0;">
                           <children>
                              <Label text="Grand Total:" textFill="#1e293b">
                                 <font>
                                    <Font name="System Bold" size="16.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="grandtotal" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 5 0;">
               <children>
                  <Button onAction="#close" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #64748B; -fx-border-radius: 6px; -fx-text-fill: #64748B; -fx-font-weight: bold; -fx-cursor: hand;" text="✕  Close" />
                  <Button fx:id="btnSave" onAction="#saveandprint" prefHeight="38.0" prefWidth="220.0" style="-fx-background-color: #16A34A; -fx-background-radius: 6px; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="🖨️  Save  Invoice" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
